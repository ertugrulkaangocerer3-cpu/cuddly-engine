          cat > app/src/main/res/values/strings.xml <<'EOF'
          <resources>
              <string name="app_name">ALPAI</string>
          </resources>
          EOF

          cat > app/src/main/res/values/themes.xml <<'EOF'
          <resources>
              <style name="Theme.Alpai" parent="android:Theme.DeviceDefault.NoActionBar" />
          </resources>
          EOF

          cat > app/src/main/java/com/alpai/assistant/MainActivity.kt <<'EOF'
          package com.alpai.assistant

          import android.os.Bundle
          import androidx.activity.ComponentActivity
          import androidx.activity.compose.setContent
          import androidx.activity.enableEdgeToEdge
          import androidx.activity.viewModels
          import com.alpai.assistant.ui.AlpaiTheme
          import com.alpai.assistant.ui.MainScreen

          class MainActivity : ComponentActivity() {
              private val vm: ChatViewModel by viewModels()

              override fun onCreate(savedInstanceState: Bundle?) {
                  enableEdgeToEdge()
                  super.onCreate(savedInstanceState)
                  setContent {
                      AlpaiTheme {
                          MainScreen(vm)
                      }
                  }
              }
